HTTP_PORT=8080

DB_USER=exchange_user
DB_PASSWORD=enter_your_password
DB_NAME=exchange_rates
DB_PORT=5432

EXCHANGE_API_URL=https://exchangerate.dev
EXCHANGE_API_KEY=can_be_empty_if_not_required_by_choisen_API

WORKER_COUNT=2
JOB_QUEUE_SIZE=100

EXTERNAL_REQUEST_TIMEOUT=10s

RATE_LIMIT_PER_MINUTE=10
