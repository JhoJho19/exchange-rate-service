# PostgreSQL
# Replace your_password with your actual password. 
# The value for POSTGRES_PASSWORD and the password in DATABASE_URL must match.
POSTGRES_PASSWORD=your_password
DATABASE_URL=postgres://exchange:your_password@127.0.0.1:5432/exchange_rates?sslmode=disable

# Supported currencies
SUPPORTED_CURRENCIES=USD,EUR,MXN

# External rate provider
RATE_PROVIDER_URL=https://api.exchangerate.dev/v1
RATE_PROVIDER_TIMEOUT=10s

# Optional API key (leave empty for keyless access)
RATE_PROVIDER_API_KEY=

# Worker pool (per instance)
WORKER_COUNT=2
# Global unfinished task limit (PENDING + PROCESSING)
QUEUE_SIZE=100
# Lease >= 1s; heartbeat every lease/3. Poll interval >= 1ms.
TASK_LEASE_DURATION=30s
WORKER_POLL_INTERVAL=100ms

# Shared provider quotas (all instances in the same DB, rolling windows)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
# Additional attempts after the initial request; 0 disables retries
RATE_LIMIT_MAX_RETRIES=2
# Exponential fallback when Retry-After is missing or invalid
RATE_LIMIT_RETRY_DELAY=60s

SHUTDOWN_TIMEOUT=30s

# HTTP listener
HTTP_ADDRESS=:8080
# Docker gateway host port; app replicas expose no host ports
API_PORT=8080
# Образ приложения для запуска через compose.hub.yaml
APP_IMAGE=jhojho19/exchange-rate-service:2.0.0

