# PostgreSQL
POSTGRES_PASSWORD=your_password
DATABASE_URL=postgres://exchange:your_password@127.0.0.1:5432/exchange_rates?sslmode=disable

# Supported currencies
SUPPORTED_CURRENCIES=USD,EUR,MXN

# External rate provider
RATE_PROVIDER_URL=https://api.exchangerate.dev/v1
RATE_PROVIDER_TIMEOUT=10s

# Optional API key (leave empty for keyless access)
RATE_PROVIDER_API_KEY=
